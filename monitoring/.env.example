# Copie para .env (chmod 600) e preencha. O .env NUNCA vai para o git.

# Grafana
GF_SECURITY_ADMIN_PASSWORD=troque-esta-senha

# UniFi (UnPoller) — use um usuário local somente leitura OU uma API key
UP_UNIFI_DEFAULT_URL=https://10.1.0.1
UP_UNIFI_DEFAULT_USER=monitor
UP_UNIFI_DEFAULT_PASS=
#UP_UNIFI_DEFAULT_API_KEY=

# Pi-hole v6 — app password de cada Pi-hole, na mesma ordem de PIHOLE_HOSTNAME
PIHOLE_PASSWORD=senha-pihole-1,senha-pihole-2

# Proxmox — token do usuário monitor@pve (papel PVEAuditor)
PVE_USER=monitor@pve
PVE_TOKEN_NAME=prometheus
PVE_TOKEN_VALUE=
