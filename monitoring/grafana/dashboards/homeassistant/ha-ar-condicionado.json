     "expr": "max by (friendly_name) (hass_climate_current_temperature_celsius{job=\"homeassistant\"})",
     "refId": "A",
     "legendFormat": "{{friendly_name}} (cômodo)"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (friendly_name) (hass_climate_target_temperature_celsius{job=\"homeassistant\"})",
     "refId": "B",
     "legendFormat": "{{friendly_name}} (desejada)"
