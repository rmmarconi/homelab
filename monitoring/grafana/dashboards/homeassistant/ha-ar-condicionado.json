      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (friendly_name) (hass_climate_current_temperature_celsius{job=\"homeassistant\"}) - on(friendly_name) max by (friendly_name) (hass_climate_target_temperature_celsius{job=\"homeassistant\"})",
     "refId": "A",
     "legendFormat": "{{friendly_name}}"
