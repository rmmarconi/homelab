    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(hass_sensor_power_w{job=\"homeassistant\",entity=\"sensor.solar_potencia\"})",
     "refId": "A",
     "instant": true
    }
   ],
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "watt",
     "noValue": "-",
     "color": {
      "mode": "fixed",
      "fixedColor": "#FADE2A"
     },
     "decimals": 0
