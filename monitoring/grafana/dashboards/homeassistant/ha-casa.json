     "expr": "sum(hass_sensor_energy_kwh{job=\"homeassistant\",entity=~\"(?i).*(solar|inversor|inverter|pv|ions|micro|geracao|production).*\",entity=~\"(?i).*(today|hoje|daily|diari).*\"})",
     "refId": "A",
     "instant": true
    }
   ],
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 6,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "kwatth",
     "noValue": "-",
     "color": {
      "mode": "fixed",
      "fixedColor": "#FADE2A"
     },
     "decimals": 2
