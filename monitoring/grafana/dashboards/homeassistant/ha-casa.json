    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (friendly_name) (hass_binary_sensor_state{job=\"homeassistant\"})",
     "refId": "A",
     "instant": true,
     "legendFormat": "{{friendly_name}}"
    }
   ],
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 30
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
