{
 "title": "Home Assistant - Casa",
 "uid": "ha-casa",
 "tags": [
  "homeassistant",
  "energia"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "refresh": "1m",
 "panels": [
  {
   "type": "row",
   "title": "Energia e solar",
   "collapsed": false,
   "panels": [],
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   }
  },
  {
   "type": "stat",
   "title": "Geração solar agora",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(hass_sensor_power_w{job=\"homeassistant\",entity=~\"(?i).*(solar|inversor|inverter|pv|ions|micro|geracao|production).*\"})",
     "refId": "A",
     "instant": true
    }
   ],
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "watt",
     "noValue": "sem inversores ainda",
     "color": {
      "mode": "fixed",
      "fixedColor": "#FADE2A"
     },
     "decimals": 0
    }
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center",
    "orientation": "horizontal"
   }
  },
  {
   "type": "stat",
   "title": "Gerado hoje",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
