     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "ativo",
         "color": "orange"
        },
        "0": {
         "text": "inativo",
         "color": "green"
        }
       }
      }
     ]
    }
   },
