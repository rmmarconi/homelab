  {
   "type": "table",
   "title": "Avisos de saúde (Radarr, Sonarr, Lidarr, Prowlarr)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 24,
    "x": 0,
    "y": 15
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "{__name__=~\"(radarr|sonarr|lidarr|prowlarr)_system_health_issues\"}",
     "refId": "A",
     "instant": true,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Value": true,
       "__name__": true,
       "instance": true,
       "job": true,
       "url": true
      },
      "indexByName": {
       "app": 0,
       "type": 1,
       "source": 2,
       "message": 3,
       "wikiurl": 4
      },
      "renameByName": {
       "app": "App",
       "type": "Tipo",
       "source": "Origem",
       "message": "Mensagem",
       "wikiurl": "Wiki"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Tipo"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 90
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "error": {
            "color": "red",
            "text": "erro"
           },
           "warning": {
            "color": "orange",
            "text": "aviso"
           },
           "notice": {
            "color": "blue",
            "text": "nota"
           }
          }
         }
        ]
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "App"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 90
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Origem"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 170
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Wiki"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 80
       },
       {
        "id": "links",
        "value": [
         {
          "title": "abrir",
          "url": "${__value.raw}",
          "targetBlank": true
         }
        ]
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "regex",
          "options": {
           "pattern": ".+",
           "result": {
            "text": "abrir"
           }
          }
         }
        ]
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   }
  },
  {
   "type": "row",
