   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(unpoller_device_wan_receive_bytes_total{wan=\"Go Internet\"}[$__range]))",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "decbytes",
     "decimals": 2,
     "noValue": "0",
     "color": {
      "mode": "fixed",
      "fixedColor": "#3274D9"
