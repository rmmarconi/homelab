  {
   "type": "timeseries",
   "title": "Throughput por WAN (download + / upload −)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 9,
    "w": 24,
    "x": 0,
    "y": 16
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (wan) (rate(unpoller_device_wan_receive_bytes_total{wan=~\"$wan\"}[$__rate_interval])) * 8",
     "refId": "A",
     "legendFormat": "{{wan}} download"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (wan) (rate(unpoller_device_wan_transmit_bytes_total{wan=~\"$wan\"}[$__rate_interval])) * 8",
     "refId": "B",
     "legendFormat": "{{wan}} upload"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bps",
     "custom": {
      "fillOpacity": 15
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Go Internet download"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#3274D9"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Go Internet upload"
      },
      "properties": [
       {
        "id": "custom.transform",
        "value": "negative-Y"
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#3274D9"
        }
       },
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          10,
          10
         ]
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Eletrodata download"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#FF9830"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Eletrodata upload"
      },
      "properties": [
       {
        "id": "custom.transform",
        "value": "negative-Y"
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#FF9830"
        }
       },
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          10,
          10
         ]
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Total por dia (últimos 30 dias)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 9,
    "w": 16,
    "x": 0,
    "y": 25
   },
   "timeFrom": "30d",
   "interval": "1d",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (wan) (increase(unpoller_device_wan_receive_bytes_total{wan=~\"$wan\"}[1d]))",
     "refId": "A",
     "legendFormat": "{{wan}} download"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (wan) (increase(unpoller_device_wan_transmit_bytes_total{wan=~\"$wan\"}[1d]))",
     "refId": "B",
     "legendFormat": "{{wan}} upload"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "decbytes",
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 80,
      "barAlignment": 0,
      "lineWidth": 1
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Go Internet download"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#3274D9"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Eletrodata download"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#FF9830"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".* upload"
      },
      "properties": [
       {
        "id": "custom.fillOpacity",
        "value": 35
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "sum"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
