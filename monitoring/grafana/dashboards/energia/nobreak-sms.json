{
 "uid": "nobreak-sms",
 "title": "Nobreak SMS",
 "tags": [
  "energia",
  "nobreak",
  "nut"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "30s",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "title": "Estado",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(network_ups_tools_ups_status{job=\"nut\",ups=\"sms\",flag=\"OL\"} * 1) + (network_ups_tools_ups_status{job=\"nut\",ups=\"sms\",flag=\"OB\"} * 2) + (network_ups_tools_ups_status{job=\"nut\",ups=\"sms\",flag=\"LB\"} * 4)",
     "refId": "A",
     "legendFormat": "__auto"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "gray",
        "value": null
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "Rede elétrica",
         "color": "green",
         "index": 0
        },
        "2": {
         "text": "Na bateria",
         "color": "orange",
         "index": 1
        },
        "6": {
         "text": "Bateria baixa",
         "color": "red",
         "index": 2
        },
        "0": {
         "text": "Desconhecido",
         "color": "gray",
         "index": 3
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "value"
   }
  },
