<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>br.homelab.node-exporter</string>
  <key>UserName</key><string>nobody</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node_exporter</string>
    <string>--web.listen-address=10.1.1.30:9100</string><string>--no-collector.thermal</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardErrorPath</key><string>/tmp/node-exporter.log</string>
</dict>
</plist>
