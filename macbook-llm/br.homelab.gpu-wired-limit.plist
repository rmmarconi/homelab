<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>br.homelab.gpu-wired-limit</string>
  <!-- LLM dedicado: GPU pode prender até 6 GB dos 8 GB (padrão ~5,3 GB) -->
  <key>ProgramArguments</key><array><string>/usr/sbin/sysctl</string><string>iogpu.wired_limit_mb=6144</string></array>
  <key>RunAtLoad</key><true/>
</dict>
</plist>
