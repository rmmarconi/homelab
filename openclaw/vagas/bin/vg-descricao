#!/usr/bin/env python3
"""vg-descricao <url>  — texto completo da vaga (requisitos, responsabilidades), sem HTML.
Suporta LinkedIn (página pública), Gupy e páginas comuns. Máx. 15 mil caracteres."""
import html
import json
import re
import sys
import urllib.request

UA = "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/142 Safari/537.36"


def get(u):
    req = urllib.request.Request(u, headers={"User-Agent": UA, "Accept-Language": "pt-BR,pt;q=0.9,en;q=0.8"})
    with urllib.request.urlopen(req, timeout=25) as r:
        return r.read().decode("utf-8", "replace")


def texto(h):
    h = re.sub(r"(?is)<(script|style|noscript|svg)[^>]*>.*?</\1>", " ", h)
    h = re.sub(r"(?i)<br\s*/?>|</(p|li|h[1-6]|div|tr)>", "\n", h)
    h = re.sub(r"(?i)<li[^>]*>", "\n- ", h)
    t = html.unescape(re.sub(r"<[^>]+>", " ", h))
    t = re.sub(r"[ \t]+", " ", t)
    return re.sub(r"\n\s*\n+", "\n\n", t).strip()


def main():
    u = sys.argv[1] if len(sys.argv) > 1 else ""
    if not re.match(r"^https?://", u):
        sys.exit("uso: vg-descricao <url>")
    m = re.search(r"linkedin\.com/jobs/view/(?:[^/]*-)?(\d+)", u)
    if m:
        p = get(f"https://www.linkedin.com/jobs-guest/jobs/api/jobPosting/{m.group(1)}")
        corpo = re.search(r'show-more-less-html__markup[^>]*>(.*?)</div>', p, re.S)
        crit = re.findall(r'description__job-criteria-subheader[^>]*>(.*?)</h3>.*?description__job-criteria-text[^>]*>(.*?)</span>', p, re.S)
        titulo = re.search(r'top-card-layout__title[^>]*>(.*?)</h2>', p, re.S)
        empresa = re.search(r'topcard__org-name-link[^>]*>(.*?)</a>', p, re.S)
        print("Título:", texto(titulo.group(1)) if titulo else "")
        print("Empresa:", texto(empresa.group(1)) if empresa else "")
        for k, v in crit:
            print(f"{texto(k)}: {texto(v)}")
        print()
        out = texto(corpo.group(1)) if corpo else texto(p)
    else:
        p = get(u)
        out = ""
        nd = re.search(r'<script id="__NEXT_DATA__"[^>]*>(.*?)</script>', p, re.S)
        if nd:
            try:
                job = json.loads(nd.group(1)).get("props", {}).get("pageProps", {}).get("job", {}) or {}
                partes = [job.get(k, "") for k in ("name", "description", "responsibilities", "prerequisites", "relevantExperiences")]
                out = texto("\n".join(x for x in partes if x))
            except (ValueError, AttributeError):
                out = ""
        out = out or texto(p)
    print(out[:15000])


if __name__ == "__main__":
    main()
